{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerLensEvidenceArtifact",
  "description": "Validated CareerLens integration artifact generated by DevAtlas Core from repository static analysis",
  "type": "object",
  "required": [
    "schemaVersion",
    "analysisId",
    "repository",
    "generatedAt",
    "skillsAndTechnologies",
    "architectureEvidence",
    "testEvidence",
    "fileInventoryEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of the CareerLens evidence contract"
    },
    "analysisId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the DevAtlas analysis run"
    },
    "repository": {
      "type": "object",
      "required": ["path", "name", "totalFiles", "totalDependencies"],
      "properties": {
        "path": { "type": "string" },
        "name": { "type": "string" },
        "totalFiles": { "type": "integer", "minimum": 0 },
        "totalDependencies": { "type": "integer", "minimum": 0 }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "skillsAndTechnologies": {
      "type": "object",
      "required": ["languages", "packages", "categorizedTools"],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "filesCount", "percentage"],
            "properties": {
              "name": { "type": "string" },
              "filesCount": { "type": "integer" },
              "percentage": { "type": "number" }
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "isDev"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "isDev": { "type": "boolean" }
            }
          }
        },
        "categorizedTools": {
          "type": "object",
          "properties": {
            "testing": { "type": "array", "items": { "type": "string" } },
            "backend": { "type": "array", "items": { "type": "string" } },
            "frontend": { "type": "array", "items": { "type": "string" } },
            "buildAndTypes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "architectureEvidence": {
      "type": "object",
      "required": ["modularityRatio", "dependencyDensity", "hasCircularDependencies", "circularChainsCount"],
      "properties": {
        "modularityRatio": { "type": "number", "description": "Ratio of dependencies to source files" },
        "dependencyDensity": { "type": "number", "description": "Average imports per module" },
        "hasCircularDependencies": { "type": "boolean" },
        "circularChainsCount": { "type": "integer" }
      }
    },
    "testEvidence": {
      "type": "object",
      "required": ["totalTestFiles", "testToCodeRatio", "testFilePaths"],
      "properties": {
        "totalTestFiles": { "type": "integer" },
        "testToCodeRatio": { "type": "number" },
        "testFilePaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fileInventoryEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "linesOfCode", "isTest", "importsCount", "importedByCount"],
        "properties": {
          "path": { "type": "string" },
          "language": { "type": "string" },
          "linesOfCode": { "type": "integer" },
          "isTest": { "type": "boolean" },
          "importsCount": { "type": "integer" },
          "importedByCount": { "type": "integer" }
        }
      }
    }
  }
}
